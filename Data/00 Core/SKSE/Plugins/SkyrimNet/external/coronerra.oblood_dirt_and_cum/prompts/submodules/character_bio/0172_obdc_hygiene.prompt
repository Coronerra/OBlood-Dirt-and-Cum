{# O'Blood, Dirt and Cum v0.3 (That Guy / Coronerra). Plain facts about Dirt and Blood state; never tells anyone what to do.
   Renders NOTHING when: Dirt and Blood is not loaded, this mod's OBDC_PromptEnabled global is off, or there is nothing to say.
   Player: the exclusive tier effects Dirty_Effect_*. NPCs: Dirt and Blood's conditional NPC effects, read ONLY while the Dirt and Blood global that drives them is 1
   (Dirty_NPCsGetBloodyTrue for blood and the follower blood bottles, Dirty_BanditsDirt, Dirty_ProfessionsDirt).
   "Washing right now": Dirt_MagicEffectSoapy (lather) or the Dirty_NPCisWashingNow spell (NPC rinse/dry). Dirty_Effect_SwimmingNPC is not read: it also sits,
   conditioned, in every NPC's blood ability.
   Since 0.3 the OCum fact lives in its own submodule, 0402_obdc_cum_covering.prompt, under "### Cum covering" (works around OStimNet's 0401 OCum details).
   Replaces the older overlay 1010_dirtandblood.prompt (remove that one). #}
{% if render_mode == "full" or render_mode == "thoughts" or render_mode == "dialogue_target" %}
{% if get_global_value("OBDC_PromptEnabled") == 1 %}
{% if actorUUID and actorUUID != 0 %}
{% set dnb_actor = decnpc(actorUUID) %}
{% if dnb_actor and dnb_actor.UUID %}
{% set dnb_pc = is_player(actorUUID) %}
{% set dnb_first = (not dnb_pc) and (render_mode == "full" or render_mode == "thoughts") %}
{% set dnb_blood = "" %}
{% set dnb_dirt = "" %}
{% set dnb_work = false %}
{% set dnb_wash = false %}
{% if is_plugin_loaded(lower("Dirt and Blood - Dynamic Visuals.esp")) %}
{% set dnb_wash = has_magic_effect(actorUUID, "Dirt_MagicEffectSoapy") %}
{% if dnb_pc %}
{% if has_magic_effect(actorUUID, "Dirty_Effect_Blood4") %}{% set dnb_blood = "soaked in blood" %}
{% elif has_magic_effect(actorUUID, "Dirty_Effect_Blood3") %}{% set dnb_blood = "covered in blood" %}
{% elif has_magic_effect(actorUUID, "Dirty_Effect_Blood2") %}{% set dnb_blood = "bloodstained" %}
{% elif has_magic_effect(actorUUID, "Dirty_Effect_Blood1") %}{% set dnb_blood = "spattered with blood" %}
{% elif has_magic_effect(actorUUID, "Dirty_Effect_Dirt4") %}{% set dnb_dirt = "filthy" %}
{% elif has_magic_effect(actorUUID, "Dirty_Effect_Dirt3") %}{% set dnb_dirt = "very dirty" %}
{% elif has_magic_effect(actorUUID, "Dirty_Effect_Dirt2") %}{% set dnb_dirt = "dirty" %}
{% endif %}
{% else %}
{% if has_spell(actorUUID, "Dirty_NPCisWashingNow") %}{% set dnb_wash = true %}{% endif %}
{% if get_global_value("Dirty_NPCsGetBloodyTrue") == 1 %}
{% if has_magic_effect(actorUUID, "Dirty_NPCEffect_Blood5") or has_magic_effect(actorUUID, "Dirty_NPCEffect_Blood4") %}{% set dnb_blood = "soaked in blood" %}
{% elif has_magic_effect(actorUUID, "Dirty_NPCEffect_Blood3") %}{% set dnb_blood = "covered in blood" %}
{% elif has_magic_effect(actorUUID, "Dirty_NPCEffect_Blood2") %}{% set dnb_blood = "bloodstained" %}
{% elif has_magic_effect(actorUUID, "Dirty_NPCEffect_Blood1") %}{% set dnb_blood = "spattered with blood" %}
{% endif %}
{% endif %}
{% if get_global_value("Dirty_BanditsDirt") == 1 %}
{% if has_magic_effect(actorUUID, "Dirty_NPCEffect_Dirt4_Bandits_Fix") %}{% set dnb_dirt = "filthy" %}
{% elif has_magic_effect(actorUUID, "Dirty_NPCEffect_Dirt3_Bandits_Fix") %}{% set dnb_dirt = "very dirty" %}
{% elif has_magic_effect(actorUUID, "Dirty_NPCEffect_Dirt2_Bandits_Fix") %}{% set dnb_dirt = "dirty" %}
{% endif %}
{% endif %}
{% if dnb_dirt == "" and get_global_value("Dirty_ProfessionsDirt") == 1 %}
{% if has_magic_effect(actorUUID, "Dirty_NPCEffect_Dirt3_Professions_Fix") %}{% set dnb_dirt = "very dirty" %}{% set dnb_work = true %}
{% elif has_magic_effect(actorUUID, "Dirty_NPCEffect_Dirt2_Professions_Fix") %}{% set dnb_dirt = "dirty" %}{% set dnb_work = true %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% if dnb_blood != "" or dnb_dirt != "" or dnb_wash %}
## Hygiene
{% if dnb_first %}
{% if dnb_blood != "" and dnb_dirt != "" %}You are {{ dnb_blood }} and {{ dnb_dirt }}.
{% elif dnb_blood != "" %}You are {{ dnb_blood }}.
{% elif dnb_work %}You are {{ dnb_dirt }} from your work.
{% elif dnb_dirt != "" %}You are {{ dnb_dirt }}.
{% endif %}
{% if dnb_wash %}You are washing right now.
{% endif %}
{% else %}
{% if dnb_blood != "" and dnb_dirt != "" %}{{ dnb_actor.name }} is {{ dnb_blood }} and {{ dnb_dirt }}.
{% elif dnb_blood != "" %}{{ dnb_actor.name }} is {{ dnb_blood }}.
{% elif dnb_work %}{{ dnb_actor.name }} is {{ dnb_dirt }} from work.
{% elif dnb_dirt != "" %}{{ dnb_actor.name }} is {{ dnb_dirt }}.
{% endif %}
{% if dnb_wash %}{{ dnb_actor.name }} is washing right now.
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
